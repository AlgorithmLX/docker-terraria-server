#!/usr/bin/env bash

set -Eeuo pipefail

source /image/scripts/common.sh

type="$(normalize_type "${TYPE:-VANILLA}")"
config_path="${SERVER_CONFIG:-/data/serverconfig.txt}"
fifo="${CONSOLE_FIFO:-/tmp/terraria/console.fifo}"

mkdir -p /data /server /tmp/terraria

append_tml_steam_args() {
  local lobby workshop_folder

  lobby="$(trim "${STEAM_LOBBY:-NONE}")"
  lobby="$(upper "$lobby")"
  lobby="${lobby//-/_}"
  lobby="${lobby// /_}"

  case "$lobby" in
    ""|NONE|NO|OFF|FALSE|DISABLED|DISABLE|0)
      command+=("-nosteam")
      ;;
    FRIENDS)
      command+=("-steam" "-lobby" "friends")
      ;;
    FRIENDS_OF_FRIENDS|FRIENDSOFFRIENDS|FOF)
      command+=("-steam" "-lobby" "friends" "-friendsoffriends")
      ;;
    PRIVATE|INVITE|INVITE_ONLY|INVITEONLY)
      command+=("-steam" "-lobby" "private")
      ;;
    CUSTOM|MANUAL|PASSTHROUGH)
      ;;
    *)
      die "Invalid STEAM_LOBBY='${STEAM_LOBBY:-}'. Use NONE, FRIENDS, FRIENDS_OF_FRIENDS, PRIVATE, or CUSTOM."
      ;;
  esac

  workshop_folder="$(trim "${STEAM_WORKSHOP_FOLDER:-}")"
  if [[ -n "$workshop_folder" ]]; then
    mkdir -p "$workshop_folder"
    command+=("-steamworkshopfolder" "$workshop_folder")
  fi
}

case "$type" in
  VANILLA)
    /image/scripts/install-vanilla
    install_dir="${VANILLA_INSTALL_DIR:-/data/server/vanilla}"
    if [[ -x "$install_dir/TerrariaServer.bin.x86_64" ]]; then
      server_bin="$install_dir/TerrariaServer.bin.x86_64"
    elif [[ -x "$install_dir/TerrariaServer" ]]; then
      server_bin="$install_dir/TerrariaServer"
    else
      die "Could not find a runnable Vanilla Terraria server binary in $install_dir"
    fi
    command=("$server_bin" "-config" "$config_path")
    ;;
  TML)
    /image/scripts/prepare-modpack
    /image/scripts/install-tml
    install_dir="${TML_INSTALL_DIR:-/data/server/tModLoader}"
    /image/scripts/manage-mods
    command=("$install_dir/start-tModLoaderServer.sh" "-config" "$config_path" "-tmlsavedirectory" "${TML_SAVE_DIR:-/data/tModLoader}")
    append_tml_steam_args
    ;;
  TSHOCK)
    /image/scripts/install-tshock
    install_dir="${TSHOCK_INSTALL_DIR:-/data/server/TShock}"
    dotnet_root="${DOTNET_INSTALL_DIR:-/data/server/dotnet}"
    tshock_config_dir="${TSHOCK_CONFIG_DIR:-/data/tshock}"
    tshock_log_dir="${TSHOCK_LOG_DIR:-$tshock_config_dir/logs}"
    tshock_crash_dir="${TSHOCK_CRASH_DIR:-$tshock_config_dir/crashes}"
    tshock_plugin_dir="${TSHOCK_PLUGIN_DIR:-$tshock_config_dir/plugins}"
    tshock_world_path="${WORLD_PATH:-/data/worlds}"

    mkdir -p "$tshock_config_dir" "$tshock_log_dir" "$tshock_crash_dir" "$tshock_plugin_dir" "$tshock_world_path"
    export DOTNET_ROOT="$dotnet_root"
    export PATH="$DOTNET_ROOT:$PATH"

    if [[ -f "$install_dir/TShock.Server.dll" ]]; then
      command=("$dotnet_root/dotnet" "$install_dir/TShock.Server.dll")
    elif [[ -x "$install_dir/TShock.Server" ]]; then
      command=("$install_dir/TShock.Server")
    else
      die "Could not find a runnable TShock server in $install_dir"
    fi

    command+=(
      "-config" "$config_path"
      "-configpath" "$tshock_config_dir"
      "-logpath" "$tshock_log_dir"
      "-crashdir" "$tshock_crash_dir"
      "-worldselectpath" "$tshock_world_path"
      "-additionalplugins" "$tshock_plugin_dir"
    )
    ;;
esac

/image/scripts/render-config "$config_path"

if [[ -n "$(trim "${EXTRA_ARGS:-}")" ]]; then
  # EXTRA_ARGS is intentionally shell-split to match Docker-style single-string env configuration.
  # Prefer serverconfig variables for values that contain spaces.
  read -r -a extra_args <<< "${EXTRA_ARGS}"
  command+=("${extra_args[@]}")
fi

log "Starting $type server on port ${PORT:-7777}"

server_pid=""

shutdown() {
  local status=$?
  trap - INT TERM

  if [[ -n "${server_pid:-}" ]] && kill -0 "$server_pid" 2>/dev/null; then
    log "Stopping Terraria server"
    if [[ -p "$fifo" ]]; then
      printf 'exit\n' > "$fifo" || true
      sleep "${STOP_WAIT_SECONDS:-10}" || true
    fi

    if kill -0 "$server_pid" 2>/dev/null; then
      kill -TERM "$server_pid" 2>/dev/null || true
      wait "$server_pid" 2>/dev/null || true
    fi
  fi

  exit "$status"
}

trap shutdown INT TERM

if truthy "${ENABLE_COMMAND_PIPE:-TRUE}"; then
  rm -f "$fifo"
  mkfifo "$fifo"
  exec 3<>"$fifo"
  "${command[@]}" <&3 &
  server_pid="$!"
  wait "$server_pid"
else
  exec "${command[@]}"
fi
