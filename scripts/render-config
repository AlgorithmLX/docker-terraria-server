#!/usr/bin/env bash

set -Eeuo pipefail

source /image/scripts/common.sh

config_path="${1:-${SERVER_CONFIG:-/data/serverconfig.txt}}"
type="$(normalize_type "${TYPE:-VANILLA}")"
config_hash_file="${SERVER_CONFIG_HASH_FILE:-${config_path}.managed-sha256}"
auto_update="${SERVER_CONFIG_AUTO_UPDATE:-TRUE}"

if [[ "$type" == "TML" ]]; then
  world_path="${WORLD_PATH:-${TML_SAVE_DIR:-/data/tModLoader}/Worlds}"
else
  world_path="${WORLD_PATH:-/data/worlds}"
fi

world_name="${WORLD_NAME:-world}"
world_file="${WORLD:-${world_path}/${world_name}.wld}"
autocreate="$(normalize_world_size "${AUTOCREATE:-2}")"
difficulty="$(normalize_difficulty "${DIFFICULTY:-0}")"
max_players="${MAX_PLAYERS:-8}"
port="${PORT:-7777}"
banlist="${BANLIST:-/data/banlist.txt}"

mkdir -p "$(dirname "$config_path")" "$world_path" "$(dirname "$banlist")"
touch "$banlist"

tmp_config="$(mktemp)"
trap 'rm -f "$tmp_config"' EXIT

{
  printf '# Generated by docker-terraria-server. Set OVERRIDE_SERVER_CONFIG=FALSE to keep manual edits.\n'
  printf 'world=%s\n' "$world_file"
  printf 'worldpath=%s\n' "$world_path"
  if [[ "$autocreate" != "0" ]]; then
    printf 'autocreate=%s\n' "$autocreate"
  fi
  [[ -n "${SEED:-}" ]] && printf 'seed=%s\n' "$SEED"
  printf 'worldname=%s\n' "$world_name"
  printf 'difficulty=%s\n' "$difficulty"
  printf 'maxplayers=%s\n' "$max_players"
  printf 'port=%s\n' "$port"
  [[ -n "${PASSWORD:-}" ]] && printf 'password=%s\n' "$PASSWORD"
  [[ -n "${MOTD:-}" ]] && printf 'motd=%s\n' "$MOTD"
  [[ -n "${LANGUAGE:-}" ]] && printf 'language=%s\n' "$LANGUAGE"
  [[ -n "${SECURE:-}" ]] && printf 'secure=%s\n' "$SECURE"
  [[ -n "${UPNP:-}" ]] && printf 'upnp=%s\n' "$UPNP"
  [[ -n "${NPC_STREAM:-}" ]] && printf 'npcstream=%s\n' "$NPC_STREAM"
  [[ -n "${PRIORITY:-}" ]] && printf 'priority=%s\n' "$PRIORITY"
  [[ -n "${WORLD_ROLLBACKS_TO_KEEP:-}" ]] && printf 'worldrollbackstokeep=%s\n' "$WORLD_ROLLBACKS_TO_KEEP"
  printf 'banlist=%s\n' "$banlist"

  if [[ "$type" == "TML" ]]; then
    printf 'modpath=%s\n' "${TML_MOD_PATH:-/data/tModLoader/Mods}"
    modpack_name="$(trim "${MODPACK:-}")"
    if [[ -z "$modpack_name" && -f /data/.modpack-name ]]; then
      modpack_name="$(trim "$(head -n 1 /data/.modpack-name)")"
    fi
    [[ -n "$modpack_name" ]] && printf 'modpack=%s\n' "$modpack_name"
  fi

  if [[ -n "${EXTRA_CONFIG:-}" ]]; then
    printf '\n# EXTRA_CONFIG\n'
    printf '%s\n' "$EXTRA_CONFIG"
  fi
} > "$tmp_config"

while IFS='=' read -r name value; do
  [[ "$name" == CFG_* ]] || continue
  key="${name#CFG_}"
  key="$(lower "$key")"
  key="${key//__/.}"
  printf '%s=%s\n' "$key" "$value" >> "$tmp_config"
done < <(env | sort)

if [[ -f /data/serverconfig.extra.txt ]]; then
  {
    printf '\n# /data/serverconfig.extra.txt\n'
    cat /data/serverconfig.extra.txt
    printf '\n'
  } >> "$tmp_config"
fi

desired_hash="$(sha256sum "$tmp_config" | awk '{print $1}')"
existing_hash=""
previous_hash=""
managed_header=FALSE

if [[ -f "$config_path" ]]; then
  existing_hash="$(sha256sum "$config_path" | awk '{print $1}')"
  if head -n 1 "$config_path" | grep -Fq 'Generated by docker-terraria-server'; then
    managed_header=TRUE
  fi
fi

if [[ -f "$config_hash_file" ]]; then
  previous_hash="$(trim "$(cat "$config_hash_file")")"
fi

write_config() {
  local message="$1"
  mkdir -p "$(dirname "$config_path")" "$(dirname "$config_hash_file")"
  mv "$tmp_config" "$config_path"
  printf '%s' "$desired_hash" > "$config_hash_file"
  trap - EXIT
  log "$message"
}

if [[ ! -f "$config_path" ]]; then
  write_config "Rendered server config $config_path"
elif truthy "${OVERRIDE_SERVER_CONFIG:-FALSE}"; then
  write_config "Overrode server config $config_path"
elif [[ "$existing_hash" == "$desired_hash" ]]; then
  mkdir -p "$(dirname "$config_hash_file")"
  printf '%s' "$desired_hash" > "$config_hash_file"
  log "Server config $config_path is up to date"
elif truthy "$auto_update" && { [[ -n "$previous_hash" && "$previous_hash" == "$existing_hash" ]] || { [[ -z "$previous_hash" ]] && truthy "$managed_header"; }; }; then
  write_config "Updated server config $config_path from environment changes"
else
  warn "Using existing server config $config_path; set OVERRIDE_SERVER_CONFIG=TRUE to replace manual edits"
fi
